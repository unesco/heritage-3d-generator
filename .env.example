# Copy to .env and fill in your own values (.env is gitignored).

# Google Earth Engine project id (required)
# https://developers.google.com/earth-engine/guides/projects
EE_PROJECT_ID=your-gee-project-id

# Output directory for generated models
OUTPUT_DIR=output

# Hugging Face token with write access (or export it in your shell)
# HF_TOKEN=hf_...

# Target HF dataset repo for upload_hf.py
# HF_DATASET_REPO=your-username/heritage-3d-models
